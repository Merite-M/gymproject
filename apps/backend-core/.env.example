# GymPartner Backend Environment Template
# Supabase Connectivity
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-for-tokens
INTERNAL_API_KEY=your-internal-system-api-key

# Payment Webhook HMAC Secrets
PAYPACK_WEBHOOK_SECRET=your-paypack-webhook-secret
MOMO_WEBHOOK_SECRET=your-momo-webhook-secret
AIRTEL_WEBHOOK_SECRET=your-airtel-webhook-secret
